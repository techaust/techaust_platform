{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "timezone": "Asia/Kolkata",
  "packageRules": [
    {
      "groupName": "cloudflare tooling",
      "matchPackageNames": ["wrangler", "@cloudflare/**", "workerd"]
    },
    {
      "groupName": "astro",
      "matchPackageNames": ["astro", "@astrojs/**"]
    },
    {
      "groupName": "react",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom", "react-router"]
    },
    {
      "groupName": "vitest",
      "matchPackageNames": ["vitest", "@vitest/**", "@cloudflare/vitest-plugin"]
    },
    {
      "description": "Full audit A1 5 (owner's yes 2026-10-30): dev tools run in CI and in the build, so their updates are reviewed like any other; nothing is automerged",
      "matchDepTypes": ["devDependencies"],
      "automerge": false
    }
  ],
  "automerge": false
}
