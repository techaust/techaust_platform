{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-opus-5-5"
  },
  "availableModels": [
    "claude-opus-5-5"
  ],
  "effortLevel": "high",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-session-start.sh\"",
            "timeout": 600,
            "statusMessage": "Session start (cloud setup only)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/model-guard.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "playwright@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "aws-core@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "sentry@synced": false,
    "supabase@synced": false,
    "upstash@synced": false
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "deniedMcpServers": [
    {
      "serverName": "supabase"
    },
    {
      "serverName": "upstash"
    },
    {
      "serverName": "aws-mcp"
    },
    {
      "serverUrl": "https://mcp.supabase.com/*"
    },
    {
      "serverUrl": "https://mcp.upstash.com/*"
    }
  ],
  "skillOverrides": {
    "docs": "off",
    "docx": "off",
    "pptx": "off",
    "google-workspace": "off",
    "import-memory": "off",
    "morning": "off",
    "skill-creator": "off",
    "consolidate-memory": "off",
    "explain-usage": "off",
    "setup-claude": "off",
    "keybindings-help": "off",
    "claude-api": "off",
    "plugin-authoring": "off",
    "init": "off",
    "fewer-permission-prompts": "off",
    "loop": "off",
    "schedule": "off",
    "workflow-authoring": "off"
  }
}
