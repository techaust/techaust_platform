{
  "name": "@techaust/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs jobs",
    "typecheck": "wrangler types --env staging && tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist --metafile && node ../../scripts/worker-budget.mjs jobs",
    "deploy:staging": "wrangler deploy --env staging",
    "types": "wrangler types --env staging"
  },
  "dependencies": {
    "@techaust/core": "workspace:*",
    "@techaust/db": "workspace:*",
    "@techaust/email": "workspace:*",
    "@techaust/pdf": "workspace:*",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@techaust/config": "workspace:*",
    "@cloudflare/vitest-plugin": "1.3.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
