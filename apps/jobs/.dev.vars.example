# Local-only email secrets. Create apps/jobs/.dev.vars with `pnpm dev:secrets` (placeholders: the local `log` transport sends nothing; git-ignored).
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# M6.2: the Razorpay webhook secret (a local fake from `pnpm dev:secrets`; staging: tools/set-gateway-keys.ps1 -Gateway razorpay-webhook). RAZORPAY_WEBHOOK_SECRET_PREVIOUS is optional (a rotation).
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# M6.3: the Stripe webhook signing secret (a local fake from `pnpm dev:secrets`; staging: tools/set-gateway-keys.ps1 -Gateway stripe-webhook). STRIPE_WEBHOOK_SECRET_PREVIOUS is optional (a rotation).
STRIPE_WEBHOOK_SECRET=
# STRIPE_WEBHOOK_SECRET_PREVIOUS=
# M6.4 (L1): the PayPal webhook's id (not a credential: the hook checks PayPal's signature offline; a local fake from `pnpm dev:secrets`, which `scripts/pay-simulate.mjs --paypal` signs for; staging: tools/set-gateway-keys.ps1 -Gateway paypal-webhook).
PAYPAL_WEBHOOK_ID=
# M7.2: the SES events hook's token, the EventBridge connection's API-key header (a local fake from `pnpm dev:secrets`; staging: run file F, H2). SES_EVENTS_TOKEN_PREVIOUS is optional (a rotation).
SES_EVENTS_TOKEN=
# SES_EVENTS_TOKEN_PREVIOUS=
# M7.2 (C.5): the HMAC key of the weekly digest's one-click unsubscribe links (a local fake from `pnpm dev:secrets`; staging: run file F, H2).
UNSUBSCRIBE_KEY=
