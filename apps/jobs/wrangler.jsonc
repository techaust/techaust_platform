{
  // hooks.techaust.com: webhooks, queue consumers and cron (docs/05-architecture.md §4).
  // Bindings (D1, R2, queues, Browser Run, crons) are added in P5.6/M1.3. Custom domains only in Phase 7.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "techaust-platform-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "local", "PAYMENTS_LIVE_ALLOWED": "false" },
  "env": {
    "staging": {
      "name": "techaust-platform-jobs-staging",
      "workers_dev": true,
      "vars": { "ENVIRONMENT": "staging", "PAYMENTS_LIVE_ALLOWED": "false" }
    },
    "production": {
      "name": "techaust-platform-jobs",
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "production", "PAYMENTS_LIVE_ALLOWED": "false" }
    }
  }
}
