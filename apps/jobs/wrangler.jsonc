{
  // hooks.techaust.com: webhooks, queue consumers and cron (docs/05-architecture.md §4).
  // D1 is bound from M1.3; R2, queues, Browser Run and crons follow with their milestones. Custom domains only in Phase 7.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "techaust-platform-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Version/Preview URLs skip Cloudflare Access, so they stay off at every level (docs/runbooks/access-staging.md;
  // CI guard: scripts/check-worker-config.mjs).
  "preview_urls": false,
  // Workers Logs: query strings are removed from logged URLs (owner decision 2026-10-21, all four Workers).
  "observability": { "enabled": true, "redact_query_string": true },
  "vars": { "ENVIRONMENT": "local", "PAYMENTS_LIVE_ALLOWED": "false" },
  // D1 (docs/05 §5). Migrations live in packages/db; local dev and tests use a local database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techaust-local",
      "database_id": "local",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "techaust-platform-jobs-staging",
      "workers_dev": true,
      // Version/Preview URLs would skip Cloudflare Access (docs/runbooks/access-staging.md).
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "staging", "PAYMENTS_LIVE_ALLOWED": "false" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "techaust-staging",
          "database_id": "879c63dd-fedd-4710-9b13-21d8804879a9",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    },
    "production": {
      "name": "techaust-platform-jobs",
      "workers_dev": false,
      "preview_urls": false,
      // Production: NO invocation logs from day one (they carry the client IP, user agent and location of every
      // request, which the append-only access log already holds for security). Console logs stay on.
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false }
      },
      "vars": { "ENVIRONMENT": "production", "PAYMENTS_LIVE_ALLOWED": "false" }
    }
  }
}
