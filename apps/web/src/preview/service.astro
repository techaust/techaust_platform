---
// M2.2 preview (dev only, noindex): the service-page template with AI Document Automation (S9), final copy from
// docs/07 §4.5 and the real pilot price from the seed catalogue. The other 13 pages reuse this template (phase 2).
import ServicePage from "../components/service/ServicePage.astro";
import { aiDocumentAutomation as s9 } from "../content/services/ai-document-automation";
import BaseLayout from "../layouts/BaseLayout.astro";
import { plainText } from "../lib/copy";
---

<BaseLayout
  title={s9.meta.title}
  description={plainText(s9.meta.description)}
  noindex
  placeholders
  current={`/services/${s9.slug}`}
>
  <ServicePage service={s9} placeholders />
</BaseLayout>
