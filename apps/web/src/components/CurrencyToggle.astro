---
// CurrencyToggle ⚡ (docs/06 §5.2, WEB-G-06): the currency setting in the footer and the phone menu, a radio group
// named "Show prices in" (07 §2.1) with the options as text, "INR / USD" (owner, 2026-10-22: codes, never "$" alone).
// Native radios, so arrow keys work. The selected code carries the 45° bar of the active nav item (the T bar of the
// mark in miniature). Every price is in the HTML in both currencies and CSS shows the active one (PriceTag), so
// switching moves nothing; hidden without JavaScript, where both prices show. State, storage and /api/geo:
// scripts/currency.ts; the look follows <html data-currency> (set by the head script), never the radios' state.
import { draft, shell } from "../content/shell";

interface Props {
  /** Unique per instance on a page (the radios' name). */
  id: string;
  /** "stack": the legend above the options (the footer); "row": legend left, options right (the phone menu). */
  layout?: "stack" | "row";
  class?: string;
}

const { id, layout = "stack", class: cls } = Astro.props;
const name = `currency-${id}`;
---

<fieldset class:list={["cur", `cur--${layout}`, "needs-js", cls]} data-currency-toggle>
  <legend class="cur__legend">{shell.currencyName}</legend>
  <div class="cur__options">
    <label class="cur__opt" data-cur-opt="inr">
      <input type="radio" name={name} value="inr" checked />
      <span class="cur__code" aria-hidden="true">{draft.inrCode}</span>
      <span class="visually-hidden">{draft.inrName}</span>
    </label>
    <span class="cur__sep" aria-hidden="true">/</span>
    <label class="cur__opt" data-cur-opt="usd">
      <input type="radio" name={name} value="usd" />
      <span class="cur__code" aria-hidden="true">{draft.usdCode}</span>
      <span class="visually-hidden">{draft.usdName}</span>
    </label>
  </div>
</fieldset>

<style>
  .cur {
    /* The options' inner padding; the group is pulled back by it so the first code lines up with the text above. */
    --cur-pad: var(--space-2);
  }

  .cur__legend {
    float: left;
    padding: 0;
  }

  .cur--stack .cur__legend {
    inline-size: 100%;
  }

  .cur--row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    inline-size: 100%;
  }

  .cur--row .cur__legend {
    font-weight: 500;
  }

  .cur__options {
    display: flex;
    align-items: center;
    margin-inline: calc(-1 * var(--cur-pad));
  }

  .cur--stack .cur__options {
    clear: both;
  }

  .cur__opt {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-min);
    min-block-size: var(--target-min);
    padding-inline: var(--cur-pad);
    border-radius: var(--radius-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .cur__opt:hover {
    color: var(--color-text);
  }

  .cur__opt input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .cur__sep {
    color: var(--color-border-control);
    user-select: none;
  }

  /* Selected: the text colour and the bar. Both follow <html data-currency>, which the head script sets before the
     first paint, so a stored "USD" is drawn at once (the radios are synced a moment later, by script). */
  :global(:root[data-currency="inr"]) .cur__opt[data-cur-opt="inr"],
  :global(:root[data-currency="usd"]) .cur__opt[data-cur-opt="usd"] {
    color: var(--color-text);
  }

  :global(:root[data-currency="inr"]) .cur__opt[data-cur-opt="inr"]::after,
  :global(:root[data-currency="usd"]) .cur__opt[data-cur-opt="usd"]::after {
    content: "";
    position: absolute;
    inset-inline: var(--cur-pad);
    inset-block-end: var(--space-1);
    block-size: 3px;
    background: var(--cur-bar, var(--color-accent-decor));
    clip-path: polygon(0 0, 100% 0, calc(100% - 3px) 100%, 0 100%);
  }

  .cur__opt:has(input:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (forced-colors: active) {
    :global(:root[data-currency="inr"]) .cur__opt[data-cur-opt="inr"]::after,
    :global(:root[data-currency="usd"]) .cur__opt[data-cur-opt="usd"]::after {
      background: Highlight;
    }
  }
</style>

<script>
  import "../scripts/currency";
</script>
