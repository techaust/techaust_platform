---
// PriceTag (docs/06 §5.2, WEB-G-06): an optional lead ("Pilot") + "from" + the amount (tabular) + "+ GST" for INR + a
// unit ("per workflow"). Amounts are minor units from lib/prices.ts (the catalogue), formatted only by @techaust/core.
//
// No layout shift when the currency changes (M2.1 follow-up M4): the INR and USD versions are complete lines that
// share one grid cell, and the inactive one is `visibility: hidden`, so the tag is always the size of the longer
// line and a first-visit INR → USD swap (/api/geo) moves nothing. The lines end with the unit, so a shorter USD
// line leaves its spare room at the end, where it can't be seen. Without JavaScript a third line shows both
// ("from ₹3,00,000 + GST · $12,000").
//
// A price without a USD amount (S11, 07 §4.7): the USD line shows the INR amount and, on its own row, "USD price on
// request". Only the USD line has that row; the INR line shares the cell, so the tag keeps the same height in both
// currencies (the INR view has the row's room as space under the price) and the swap moves nothing.
import type { Money } from "@techaust/core";
import { shared } from "../content/shared";
import { draft } from "../content/shell";
import { displayAmount } from "../lib/prices";

interface Props {
  inr: Money;
  usd: Money | null;
  unit?: string;
  /** A word before "from", as 07 writes it ("Pilot {{price:S9}}"). */
  lead?: string;
  /** lg: text-price-lg (heroes, pricing); md: card prices. */
  size?: "lg" | "md";
  /** "from" before the amount (default). Exact prices (care-plan tiers, owner 2026-10-22) leave it out. */
  from?: boolean;
  /** "USD price on request" in the USD line when there's no USD amount (default). Off for all but one tag of a group. */
  ask?: boolean;
  /** Labels the tag "Sample" (preview pages only). */
  sample?: boolean;
  class?: string;
}

const {
  inr,
  usd,
  unit,
  lead,
  size = "lg",
  from = true,
  ask = true,
  sample = false,
  class: cls,
} = Astro.props;
const lines = [
  { mode: "both", amounts: usd ? [inr, usd] : [inr] },
  { mode: "inr", amounts: [inr] },
  { mode: "usd", amounts: [usd ?? inr] },
] as const;
---

<p class:list={["price", `price--${size}`, cls]}>
  {sample && <span class="price__sample">{draft.sample}</span>}
  <span class="price__stack">
    {
      lines.map(({ mode, amounts }) => (
        <span class={`price__line price__line--${mode}`}>
          {lead && <span class="price__lead">{lead}</span>}
          {from && <span class="price__from">{draft.priceFrom}</span>}
          {amounts.map((m, i) => (
            <>
              {i > 0 && (
                <span class="price__sep" aria-hidden="true">
                  ·
                </span>
              )}
              <span class="price__amount">{displayAmount(m)}</span>
              {m.currency === "INR" && <span class="price__gst">{draft.gst}</span>}
            </>
          ))}
          {unit && <span class:list={["price__unit", unit.startsWith("/") && "price__unit--tight"]}>{unit}</span>}
          {mode !== "inr" && !usd && ask && <span class="price__ask">{shared.usdOnRequest}</span>}
        </span>
      ))
    }
  </span>
</p>

<style>
  .price {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .price__sample {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    font-weight: 600;
    color: var(--color-warning);
  }

  .price__stack {
    display: grid;
  }

  .price__line {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-2);
    row-gap: 0;
  }

  .price__lead {
    font-weight: 600;
    color: var(--color-text);
  }

  .price__from,
  .price__unit,
  .price__gst,
  .price__sep {
    color: var(--color-text-muted);
  }

  /* "USD price on request": its own row under the amount, in the quiet small size. */
  .price__ask {
    flex-basis: 100%;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-text-muted);
  }

  /* "/mo", "/month" (07 writes them attached): no gap before the slash. */
  .price__unit--tight {
    margin-inline-start: calc(-1 * var(--space-2));
  }

  .price__amount {
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .price--lg .price__amount {
    font-size: var(--text-price-lg);
    line-height: var(--text-price-lg--line-height);
    font-weight: var(--text-price-lg--font-weight);
  }

  .price--md .price__amount {
    font-size: var(--text-h4);
    line-height: var(--text-h4--line-height);
    font-weight: 600;
  }

  .price--md .price__lead,
  .price--md .price__from,
  .price--md .price__unit,
  .price--md .price__gst,
  .price--md .price__sep {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
  }

  /* Without JavaScript: only the line with both amounts. With it: the two single-currency lines in one cell. */
  :global(:root:not(.js)) .price__line--inr,
  :global(:root:not(.js)) .price__line--usd,
  :global(:root.js) .price__line--both {
    display: none;
  }

  :global(:root[data-currency="inr"]) .price__line--usd,
  :global(:root[data-currency="usd"]) .price__line--inr {
    visibility: hidden;
  }
</style>
