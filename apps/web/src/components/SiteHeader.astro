---
// SiteHeader ⚡ (docs/06 §5.2, 07 §2.1, WEB-G-03): logo, Services ▾ · Industries ▾ · Pricing · Work · About · Contact,
// ₹/$ and theme toggles, and the CTA. Sticky, with a hairline once the page scrolls (no hide-on-scroll).
// Without JavaScript the two menus and the mobile menu are <details>; the script (below) turns them into disclosure
// buttons with aria-expanded (Esc closes and returns focus) and the mobile menu into a modal dialog.
import { discoveryHref } from "../config/site";
import { draft, shell } from "../content/shell";
import "../styles/header.css";
import CurrencyToggle from "./CurrencyToggle.astro";
import IndustriesPanel from "./header/IndustriesPanel.astro";
import MobileNav from "./header/MobileNav.astro";
import ServicesPanel from "./header/ServicesPanel.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** The current page's path, for aria-current and the indicator. */
  current?: string | undefined;
  /** Unique per header on a page (the components preview shows more than one). */
  idPrefix?: string;
  /** Preview only: a header in the page flow (not sticky), optionally in its scrolled look. */
  specimen?: "top" | "scrolled";
  /** Preview only: start with a menu open. */
  open?: "services" | "industries";
}

const { current, idPrefix = "hd", specimen, open } = Astro.props;
const inServices = current?.startsWith("/services") ?? false;
const inIndustries = current?.startsWith("/industries") ?? false;
---

{!specimen && <div class="scroll-sentinel" data-scroll-sentinel aria-hidden="true" />}
<header
  class:list={["site-header", specimen && "site-header--specimen"]}
  data-site-header={specimen ? undefined : ""}
  data-scrolled={specimen === "scrolled" ? "" : undefined}
>
  <div class="site-header__bar">
    <Logo />
    <nav class="primary-nav" aria-label={specimen ? `${draft.mainNav} (specimen ${idPrefix})` : draft.mainNav}>
      <ul role="list" class="primary-nav__list">
        <li class="primary-nav__item primary-nav__item--wide">
          <details class="nav-disclosure" data-disclosure open={open === "services" || undefined}>
            <summary class:list={["nav-link", "nav-trigger", inServices && "is-current"]}>
              {shell.nav.services}
              <Icon name="chevron-down" size={16} class="chev" />
            </summary>
            <div class="nav-panel nav-panel--services" id={`${idPrefix}-services`} data-panel>
              <ServicesPanel current={current} idPrefix={`${idPrefix}-svc`} />
            </div>
          </details>
        </li>
        <li class="primary-nav__item">
          <details class="nav-disclosure" data-disclosure open={open === "industries" || undefined}>
            <summary class:list={["nav-link", "nav-trigger", inIndustries && "is-current"]}>
              {shell.nav.industries}
              <Icon name="chevron-down" size={16} class="chev" />
            </summary>
            <div class="nav-panel nav-panel--industries" id={`${idPrefix}-industries`} data-panel>
              <IndustriesPanel current={current} />
            </div>
          </details>
        </li>
        {
          shell.nav.links.map((link) => (
            <li class="primary-nav__item">
              <a class="nav-link" href={link.href} aria-current={current === link.href ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__tools">
      <div class="site-header__toggles">
        <CurrencyToggle id={`${idPrefix}-cur`} />
        <ThemeToggle />
      </div>
      <a class="btn btn--primary site-header__cta" href={discoveryHref}>{shell.cta}</a>
      <details class="mobile-menu" data-mobile-menu>
        <summary class="menu-trigger">
          <span>{draft.menu}</span>
          <Icon name="menu" size={24} />
        </summary>
        <div class="mobile-panel" data-mobile-panel>
          <MobileNav current={current} idPrefix={`${idPrefix}-m`} />
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // ~1.5 KB: the scrolled hairline, the two disclosure menus and the mobile menu dialog.
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const sentinel = document.querySelector("[data-scroll-sentinel]");
  if (header && sentinel) {
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute("data-scrolled", !entry?.isIntersecting);
    }).observe(sentinel);
  }

  /** Swap a <details> for a <button> carrying the summary's look and content (no layout change). */
  function toButton(summary: HTMLElement): HTMLButtonElement {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = summary.className;
    btn.innerHTML = summary.innerHTML;
    return btn;
  }

  type Menu = { wrap: HTMLElement; btn: HTMLButtonElement; panel: HTMLElement };
  const menus: Menu[] = [];

  function setOpen(menu: Menu, open: boolean) {
    menu.btn.setAttribute("aria-expanded", String(open));
    menu.panel.hidden = !open;
    menu.wrap.toggleAttribute("data-open", open);
  }

  for (const details of document.querySelectorAll<HTMLDetailsElement>("details[data-disclosure]")) {
    const summary = details.querySelector<HTMLElement>(":scope > summary");
    const panel = details.querySelector<HTMLElement>(":scope > [data-panel]");
    if (!summary || !panel) continue;
    const btn = toButton(summary);
    btn.setAttribute("aria-controls", panel.id);
    const wrap = document.createElement("div");
    wrap.className = details.className;
    wrap.append(btn, panel);
    const menu: Menu = { wrap, btn, panel };
    setOpen(menu, details.open);
    details.replaceWith(wrap);
    menus.push(menu);

    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") !== "true";
      for (const other of menus) if (other !== menu) setOpen(other, false);
      setOpen(menu, open);
    });
    wrap.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        setOpen(menu, false);
        btn.focus();
      }
    });
    wrap.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !wrap.contains(next)) setOpen(menu, false);
    });
  }

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    for (const menu of menus) if (!menu.wrap.contains(target)) setOpen(menu, false);
  });

  // The mobile menu: a modal dialog, so focus stays inside and Esc closes it (both native).
  const mobile = document.querySelector<HTMLDetailsElement>("details[data-mobile-menu]");
  const mobileSummary = mobile?.querySelector<HTMLElement>(":scope > summary");
  const mobilePanel = mobile?.querySelector<HTMLElement>(":scope > [data-mobile-panel]");
  if (mobile && mobileSummary && mobilePanel) {
    const btn = toButton(mobileSummary);
    btn.setAttribute("aria-haspopup", "dialog");
    const dialog = document.createElement("dialog");
    dialog.className = "mobile-dialog";
    dialog.setAttribute("aria-label", mobileSummary.textContent?.trim() || "Menu");
    dialog.append(mobilePanel);
    document.body.append(dialog);
    mobile.replaceWith(btn);

    const close = mobilePanel.querySelector<HTMLButtonElement>("[data-menu-close]");
    btn.addEventListener("click", () => {
      dialog.showModal();
      close?.focus();
    });
    close?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => btn.focus());
    // A link inside the menu that stays on this page (an anchor) closes it.
    dialog.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) dialog.close();
    });
    window.matchMedia("(min-width: 80rem)").addEventListener("change", (event) => {
      if (event.matches && dialog.open) dialog.close();
    });
  }
</script>
