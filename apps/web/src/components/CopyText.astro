---
// CopyText: one piece of docs/07 copy, rendered as written. It does three jobs the plain string can't:
// 1. Prices in running text, through lib/tokens.ts parseTokens (the one renderer, WEB-G-07): {{price:Sx}} →
//    "from ₹40,000 + GST" or "from $2,000" ("from" once when 07 already writes it); {{price-plain:Sx}} → the amount
//    alone. An unknown token or a hidden service fails the build. No layout shift when the currency changes (WEB-G-06):
//    the whole text is written once per currency and both versions sit in the same grid cell; the inactive one is
//    `visibility: hidden`, so the box is always as tall as the longer one. Without JavaScript a third version shows
//    both amounts ("from ₹40,000 + GST · $2,000"). A price without a USD amount (S11) shows the INR amount in the USD
//    version too, followed by "· USD price on request" (07 §4.7).
// 2. Arrows. 07 writes "→" and "↔"; neither is in the fonts (docs/06 §3.1), so each becomes an icon, with the
//    character kept, visually hidden, for assistive technology and copy-paste.
// 3. Bold. 07's **…** becomes <strong> (S1 credit rule, S4 "Led personally by our founder.", the care-plan SLAs).
// 4. Links. 07-A writes Markdown links ("[Cookie policy](/cookies)"); they become <a>. The target "#cookie-settings"
//    is the footer's "Cookie settings" control: a link to the cookie policy that opens the preferences dialog when
//    JavaScript runs (CookieConsent handles every [data-cookie-settings]).
// 5. Inline code. 07-A's `ta_consent`-style names become <code>.
// 6. A pending owner input ({{postal_address}} while site.postalAddress is empty) is drawn as a marked gap, never as
//    ordinary text, so nobody mistakes it for the address.
// 7. Short joined runs never break inside: a range of short words or times ("Mon–Sat,", "10:00–19:00") and an "e-" word
//    ("e-invoicing", "e-way"), so a line never ends on "(Mon–" or "GST e-" (final sweep W6).
import { shared } from "../content/shared";
import { draft } from "../content/shell";
import { displayAmount } from "../lib/prices";
import { POSTAL_ADDRESS_PLACEHOLDER, type PricePart, parseTokens } from "../lib/tokens";
import Icon from "./Icon.astro";

interface Props {
  text: string;
  as?: "p" | "span" | "div";
  class?: string;
}

const { text, as: Tag = "p", class: cls } = Astro.props;

type Mode = "both" | "inr" | "usd";
type Bit =
  | { kind: "text"; value: string; bold: boolean }
  | { kind: "keep"; value: string; bold: boolean }
  | { kind: "arrow"; char: "→" | "↔"; bold: boolean }
  | { kind: "link"; label: string; href: string; bold: boolean }
  | { kind: "pending"; value: string }
  | { kind: "code"; value: string };
const LINK = /\[([^\]]+)\]\(([^)\s]+)\)/g;
/** Item 7: the runs kept on one line (a capture group, so `split` keeps them). */
const KEEP = /((?<![\p{L}\d])[\p{L}\d:]{1,5}–[\p{L}\d:]{1,5}(?![\p{L}\d]),?|(?<![\p{L}\d-])e-\p{L}+)/u;
type Part = Bit | PricePart;

const parts: Part[] = [];
let bold = false;
for (const p of parseTokens(text)) {
  if (p.kind === "price") {
    parts.push(p);
    continue;
  }
  if (p.text === POSTAL_ADDRESS_PLACEHOLDER) {
    parts.push({ kind: "pending", value: p.text });
    continue;
  }
  p.text.split("**").forEach((run, i) => {
    if (i > 0) bold = !bold;
    const plain = (t: string) => {
      t.split("`").forEach((piece, j) => {
        if (j % 2 === 1) {
          parts.push({ kind: "code", value: piece });
          return;
        }
        for (const bit of piece.split(/([→↔])/)) {
          if (bit === "→" || bit === "↔") parts.push({ kind: "arrow", char: bit, bold });
          else if (bit)
            bit.split(KEEP).forEach((run, k) => {
              if (run) parts.push({ kind: k % 2 === 1 ? "keep" : "text", value: run, bold });
            });
        }
      });
    };
    let at = 0;
    for (const m of run.matchAll(LINK)) {
      plain(run.slice(at, m.index));
      parts.push({ kind: "link", label: m[1] as string, href: m[2] as string, bold });
      at = m.index + m[0].length;
    }
    plain(run.slice(at));
  });
}
if (bold) throw new Error(`CopyText: unbalanced "**" in "${text.slice(0, 60)}"`);

const priced = parts.some((p) => p.kind === "price");
// "USD price on request" once per string: after the last price without a USD amount.
const askAt = parts.findLastIndex((p) => p.kind === "price" && !p.plain && !p.usd);
const modes: (Mode | null)[] = priced ? ["both", "inr", "usd"] : [null];
---

<Tag class:list={["copy", priced && "copy--priced", cls]}>
  {
    modes.map((mode) => (
      <span class:list={["copy__v", mode && `copy__v--${mode}`]}>
        {parts.map((p, i) =>
          p.kind === "text" ? (
            p.bold ? (
              <strong class="copy__strong">{p.value}</strong>
            ) : (
              p.value
            )
          ) : p.kind === "keep" ? (
            <span class="copy__keep">{p.bold ? <strong class="copy__strong">{p.value}</strong> : p.value}</span>
          ) : p.kind === "link" ? (
            p.href === "#cookie-settings" ? (
              <a href="/cookies" data-cookie-settings>
                {p.bold ? <strong class="copy__strong">{p.label}</strong> : p.label}
              </a>
            ) : (
              <a href={p.href} rel={/^https?:/.test(p.href) ? "noopener" : undefined}>
                {p.bold ? <strong class="copy__strong">{p.label}</strong> : p.label}
              </a>
            )
          ) : p.kind === "code" ? (
            <code class="copy__code">{p.value}</code>
          ) : p.kind === "pending" ? (
            <span class="copy__pending">{p.value}</span>
          ) : p.kind === "arrow" ? (
            <span class="copy__arrow">
              <Icon name={p.char === "→" ? "arrow-right" : "move-horizontal"} size={16} />
              <span class="visually-hidden">{p.char}</span>
            </span>
          ) : p.plain ? (
            <span class="copy__amount">
              {mode === "usd" && p.usd ? displayAmount(p.usd) : displayAmount(p.inr)}
              {mode === "both" && p.usd && ` · ${displayAmount(p.usd)}`}
            </span>
          ) : (
            <>
              {p.from && `${draft.priceFrom} `}
              {mode === "usd" && p.usd ? (
                <span class="copy__amount">{displayAmount(p.usd)}</span>
              ) : (
                <span class="copy__price">
                  <span class="copy__amount">{displayAmount(p.inr)}</span> {draft.gst}
                  {mode === "both" && p.usd && (
                    <>
                      {" · "}
                      <span class="copy__amount">{displayAmount(p.usd)}</span>
                    </>
                  )}
                </span>
              )}
              {mode !== "inr" && i === askAt && ` · ${shared.usdOnRequest}`}
            </>
          ),
        )}
      </span>
    ))
  }
</Tag>

<style>
  .copy__amount,
  .copy__strong {
    font-weight: 600;
    color: var(--color-text);
  }

  .copy__amount {
    font-variant-numeric: tabular-nums;
  }

  /* "₹40,000 + GST" never breaks inside. */
  .copy__price,
  .copy__amount,
  .copy__keep {
    white-space: nowrap;
  }

  /* 07-A's `names` (cookie and storage keys): the mono face, a touch smaller so it sits on the text's x-height. */
  .copy__code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  /* A pending owner input inside running text: a dashed underline in the warning colour, the words say what's missing. */
  .copy__pending {
    font-weight: 600;
    color: var(--color-text);
    text-decoration: underline dashed var(--color-warning);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .copy__arrow {
    display: inline-flex;
    vertical-align: -0.15em;
    margin-inline: 0.15em;
  }

  /* Prices: the three versions share one cell; the box is as tall as the longest, so a swap shifts nothing. */
  .copy--priced {
    display: grid;
  }

  .copy--priced > .copy__v {
    grid-area: 1 / 1;
  }

  :global(:root:not(.js)) .copy__v--inr,
  :global(:root:not(.js)) .copy__v--usd,
  :global(:root.js) .copy__v--both {
    display: none;
  }

  :global(:root[data-currency="inr"]) .copy__v--usd,
  :global(:root[data-currency="usd"]) .copy__v--inr {
    visibility: hidden;
  }
</style>
