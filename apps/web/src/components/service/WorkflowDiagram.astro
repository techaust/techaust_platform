---
// The illustrative workflow diagram (docs/06 §4.5 and §5.2 DiagramFrame, 07 §1.2 rule 3 and §2.4): a <figure>
// whose caption is the 07 "Illustrative example" line, holding the stations of the flow as an ordered list (so it
// reads in order to assistive tech and needs no image). Stations sit on one ink line, joined by arrow icons; across
// from 1024 px, down on narrower screens. The frame's top-right corner is cut at 45° (docs/06 §4.3: the corner of the
// hero image frame). Tokens and currentColor only, so it works in both themes.
import { shared } from "../../content/shared";
import Icon from "../Icon.astro";

interface Props {
  stations: readonly string[];
  /** The accessible name of the list ("Inbox to audit log"), from the first and last station. */
  class?: string;
}

const { stations, class: cls } = Astro.props;
---

<figure class:list={["diagram", cls]}>
  <figcaption class="diagram__caption">
    <Icon name="info" size={16} />
    <span>{shared.illustrative}</span>
  </figcaption>
  <ol class="flow" role="list">
    {
      stations.map((s, i) => (
        <li class="flow__station">
          <span class="flow__n" aria-hidden="true">
            {i + 1}
          </span>
          <span class="flow__name">{s}</span>
          {i < stations.length - 1 && <Icon name="arrow-right" size={20} class="flow__arrow" />}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .diagram {
    --cut: var(--space-8);
    position: relative;
    padding: var(--space-6) var(--space-5) var(--space-8);
    background: var(--color-surface);
    /* The border follows the cut corner: an outline layer underneath, one pixel larger. */
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  /* The cut edge's own hairline (the inset shadow stops at the clip). */
  .diagram::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    inline-size: var(--cut);
    block-size: var(--cut);
    background: linear-gradient(
      to top right,
      transparent calc(50% - 0.75px),
      var(--color-border) calc(50% - 0.75px),
      var(--color-border) calc(50% + 0.75px),
      transparent calc(50% + 0.75px)
    );
    pointer-events: none;
  }

  @media (min-width: 48rem) {
    .diagram {
      --cut: var(--space-12);
      padding: var(--space-8) var(--space-8) var(--space-10);
    }
  }

  .diagram__caption {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    font-weight: 500;
    color: var(--color-text-muted);
    padding-inline-end: var(--cut);
  }

  .diagram__caption :global(.icon) {
    color: var(--color-text-accent);
  }

  .flow {
    --gap: var(--space-8);
    display: grid;
    gap: var(--gap);
    margin-block-start: var(--space-8);
  }

  .flow__station {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: calc(var(--space-12) + var(--space-2));
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }

  .flow__n {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-accent);
  }

  /* 07 writes the stations in running-text case ("extract"); as labels they start with a capital. */
  .flow__name {
    display: block;
    font-weight: 600;
  }

  .flow__name::first-letter {
    text-transform: uppercase;
  }

  /* Phones and tablets: down the page; the arrow sits in the gap below each station, turned to point down. */
  .flow__station > :global(.flow__arrow) {
    position: absolute;
    inset-block-start: calc(100% + (var(--gap) - var(--space-5)) / 2);
    inset-inline-start: var(--space-4);
    rotate: 90deg;
    color: var(--color-text-muted);
  }

  @media (min-width: 64rem) {
    .flow {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      --gap: var(--space-8);
    }

    .flow__station {
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-4);
      min-block-size: var(--space-24);
    }

    .flow__station > :global(.flow__arrow) {
      inset-block-start: 50%;
      inset-inline-start: calc(100% + (var(--gap) - var(--space-5)) / 2);
      translate: 0 -50%;
      rotate: none;
    }
  }

  @media (forced-colors: active) {
    .diagram {
      clip-path: none;
      border: 1px solid CanvasText;
    }

    .diagram::before {
      display: none;
    }
  }
</style>
