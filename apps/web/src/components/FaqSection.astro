---
// A page's FAQ section: the heading in the left column, the disclosure list in the right.
import type { FaqItem } from "../content/types";
import FAQ from "./FAQ.astro";

interface Props {
  title: string;
  items: readonly FaqItem[];
  id?: string;
  flushTop?: boolean;
  /** Preview only: items open on load. */
  open?: readonly number[];
}

const { title, items, id = "faq-title", flushTop = false, open } = Astro.props;
---

{
  items.length > 0 && (
    <section class:list={["section", flushTop && "section--flush-top"]} aria-labelledby={id}>
      <div class="container split">
        <h2 class="t-h2" id={id}>
          {title}
        </h2>
        <FAQ items={items} open={open} />
      </div>
    </section>
  )
}
