---
// A page's FAQ section: the heading in the left column, the disclosure list in the right. The same items become the
// page's FAQPage JSON-LD (WEB-SVC-04), so the visible answers and the data can't drift apart.
import type { FaqItem } from "../content/types";
import { plainCopy } from "../lib/copy";
import { addLd } from "../lib/ld-collector";
import { cleanPath } from "../lib/page-path";
import { faqNode } from "../lib/structured-data";
import FAQ from "./FAQ.astro";

interface Props {
  title: string;
  items: readonly FaqItem[];
  id?: string;
  flushTop?: boolean;
  /** Preview only: items open on load. */
  open?: readonly number[];
}

const { title, items, id = "faq-title", flushTop = false, open } = Astro.props;
if (items.length > 0)
  addLd(
    Astro.request,
    faqNode(
      items.map((f) => ({ q: plainCopy(f.q), a: plainCopy(f.a) })),
      cleanPath(Astro.url.pathname),
    ),
  );
---

{
  items.length > 0 && (
    <section class:list={["section", flushTop && "section--flush-top"]} aria-labelledby={id}>
      <div class="container split">
        <h2 class="t-h2" id={id}>
          {title}
        </h2>
        <FAQ items={items} open={open} />
      </div>
    </section>
  )
}
