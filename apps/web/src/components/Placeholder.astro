---
// Marks a pending owner input (docs/07 §9) where the real value will go. Never a link and never an invented value.
// The shell hides its optional items while their config value is empty and shows this only on preview pages; the
// About page shows it on the built site for the founder's headshot, bio and LinkedIn (M2.3 brief), and the
// pre-production check (scripts/check-prod-readiness.mjs) fails while any built page still contains the
// `placeholder__tag` marker, so none reaches production. Keep the class name.
interface Props {
  /** What is missing, e.g. "LinkedIn company URL". */
  what: string;
  /** Why it is missing (default: a pending owner input). */
  reason?: string;
  class?: string;
}

const { what, reason = "owner input pending", class: cls } = Astro.props;
---

<span class:list={["placeholder", cls]}>
  <span class="placeholder__tag">Placeholder</span>
  <span>{what} ({reason})</span>
</span>

<style>
  .placeholder {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    min-height: var(--target-min);
    padding: var(--space-1) var(--space-3);
    border: 1px dashed var(--placeholder-accent, var(--color-warning));
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-text);
  }

  .placeholder__tag {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    font-weight: 600;
    color: var(--placeholder-accent, var(--color-warning));
  }
</style>
