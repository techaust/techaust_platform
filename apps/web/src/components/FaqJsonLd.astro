---
// FAQPage JSON-LD (WEB-SVC-04) from the same FaqItem data the visible FAQ renders, so the two can't drift apart.
import type { FaqItem } from "../content/types";
import { plainCopy } from "../lib/copy";
import JsonLd from "./JsonLd.astro";

interface Props {
  items: readonly FaqItem[];
}

const { items } = Astro.props;
const data = {
  "@type": "FAQPage",
  mainEntity: items.map((f) => ({
    "@type": "Question",
    name: plainCopy(f.q),
    acceptedAnswer: { "@type": "Answer", text: plainCopy(f.a) },
  })),
};
---

{items.length > 0 && <JsonLd data={data} />}
