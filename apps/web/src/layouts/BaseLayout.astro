---
// The base layout of every page (WEB-G-05, -16): en-IN, the skip link, landmarks (header, main, footer), the inline
// theme script for a first paint in the right theme, the one font file preloaded, and meta slots for the title,
// description, canonical and link preview (filled per page in M2.5, WEB-G-09).
import "@techaust/ui/fonts.css";
import "@techaust/ui/tokens.css";
import "../styles/global.css";
import appleTouch from "@techaust/ui/brand/apple-touch-icon.png?url";
import favicon from "@techaust/ui/brand/favicon.svg?url";
import ogDefault from "@techaust/ui/brand/og-default.png?url";
import archivoLatin from "@techaust/ui/fonts/archivo-latin.woff2?url";
import CookieConsent from "../components/CookieConsent.astro";
import PageGraph from "../components/PageGraph.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../config/site";
import { draft } from "../content/shell";
import { ogPath } from "../lib/og";
import { cleanPath } from "../lib/page-path";

interface Props {
  title: string;
  description?: string;
  /** Path on techaust.com for the canonical link (defaults to this page's path). */
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** For aria-current in the header (defaults to this page's path). */
  current?: string;
  /** Preview pages: show labelled placeholders for pending owner inputs. */
  placeholders?: boolean;
  /** Preview pages: override the consent banner (the build follows site.ga4Id). */
  consent?: { banner: "off" | "auto" | "always"; analytics: boolean };
  /** Preview pages: open a header menu on load. */
  openMenu?: "services" | "industries";
  /** Link the blog's RSS feed in the head (the blog index, once a post is published). */
  rss?: boolean;
}

const {
  title,
  description,
  canonical = cleanPath(Astro.url.pathname),
  ogImage,
  noindex = false,
  current = cleanPath(Astro.url.pathname),
  placeholders = false,
  consent = { banner: site.ga4Id ? "auto" : "off", analytics: Boolean(site.ga4Id) },
  openMenu,
  rss = false,
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site).href;
// Every page has a share image of its own, /og/<slug>.png, rendered after the build (scripts/build-og.mjs); the 404
// keeps the default image.
const og = new URL(
  ogImage ?? (cleanPath(Astro.url.pathname) === "/404" ? ogDefault : ogPath(Astro.url.pathname)),
  Astro.site,
).href;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouch} />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    {rss && <link rel="alternate" type="application/rss+xml" title="TecHaust Technologies: Blog" href="/rss.xml" />}
    {/* First paint in the right theme and currency (< 1 KB; hashed in the CSP, WEB-G-12). A stored choice (ta_currency)
        wins over the cached /api/geo answer (ta_geo, 30 days, set by scripts/currency.ts); else INR. "has-ref": the
        URL carries a lead reference, so /thanks keeps room for its reference lines (thanks.astro; none on a bookmark). */}
    <script is:inline>
      (function (d) {
        d.classList.add("js");
        if (/[?&]ref=[^&]/.test(location.search)) d.classList.add("has-ref");
        try {
          var t = localStorage.getItem("ta_theme");
          if (t === "light" || t === "dark") d.dataset.theme = t;
          var c = localStorage.getItem("ta_currency");
          if (c !== "inr" && c !== "usd") {
            var g = JSON.parse(localStorage.getItem("ta_geo") || "null");
            c = g && g.at > Date.now() - 2592e6 && g.c === "usd" ? "usd" : "inr";
          }
          d.dataset.currency = c;
        } catch (e) {
          d.dataset.currency = "inr";
        }
      })(document.documentElement);
    </script>
    {/* The hours (footer, contact, forms, care plans) in the visitor's own clock (owner, 2026-11-01). In the head so
        the small module is fetched alongside the stylesheet and runs as soon as the page is parsed, before the first
        paint where it can, so the rewritten hours don't move the text below them (layout shift). */}
    <script>
      import "../scripts/local-time";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{draft.skipLink}</a>
    <CookieConsent banner={consent.banner} analytics={consent.analytics} />
    <SiteHeader current={current} open={openMenu} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter placeholders={placeholders} />
    <PageGraph />
  </body>
</html>

<script>
  // First-touch attribution for the forms (FRM-06): UTM parameters and an outside referrer, sessionStorage only.
  import "../scripts/attribution";
</script>

<style is:global>
  .skip-link {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: 100;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: 600;
    text-decoration: none;
    translate: 0 calc(-100% - var(--space-4));
  }

  .skip-link:focus-visible {
    translate: none;
    color: var(--color-bg);
  }
</style>
