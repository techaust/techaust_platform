---
// Contact (/contact, WEB-CONTACT, FRM-CONTACT, docs/07 §5.8). The form posts to the website Worker's
// /api/forms/contact (M2.4 builder): with JavaScript it is checked against the shared schema (contactForm,
// @techaust/core) on blur and on submit and sent as JSON, then the visitor goes to /thanks?ref=…; without JavaScript it
// is a plain form POST, which the Worker answers with the no-JavaScript notice (owner, 2026-10-23), so the page says
// so up front and above the button. The side panel: email; WhatsApp and the Cal.com link hide while their value is
// empty (WEB-G-18); the postal address shows as a marked gap until the owner gives it (07 §9).
import "../styles/page.css";
import "../styles/forms.css";
import CopyText from "../components/CopyText.astro";
import ExternalLink from "../components/ExternalLink.astro";
import ErrorSummary from "../components/form/ErrorSummary.astro";
import Field from "../components/form/Field.astro";
import FormEnd from "../components/form/FormEnd.astro";
import SpamGuard from "../components/form/SpamGuard.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../config/site";
import { contactPage as c, formUi, noJsNote } from "../content/forms";
import { draft, shell } from "../content/shell";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={c.meta.title} description={c.meta.description}>
  <PageHero title={c.h1} lede={c.lede} />

  <section class="section">
    <div class="container contact">
      <form
        class="form contact__form"
        id="contact-form"
        action="/api/forms/contact"
        method="post"
        aria-labelledby="page-title"
        data-form="contact"
        data-msg-generic={formUi.generic}
        data-msg-rate={formUi.rateLimited}
        data-msg-nojs={noJsNote}
      >
        <ErrorSummary id="contact-errors" />
        <p class="form-note no-js-only">
          <Icon name="info" size={20} />
          <span>{noJsNote}</span>
        </p>
        <div class="form-row">
          <Field name="name" label={c.labels.name} autocomplete="name" required maxlength={100} />
          <Field
            name="email"
            label={c.labels.email}
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            maxlength={254}
          />
          <Field name="company" label={c.labels.company} autocomplete="organization" maxlength={120} />
          <Field name="phone" label={c.labels.phone} type="tel" autocomplete="tel" inputmode="tel" maxlength={30} />
        </div>
        <Field
          name="message"
          label={c.labels.message}
          hint={c.hints.message}
          type="textarea"
          required
          maxlength={2000}
          rows={7}
        />
        <input type="hidden" name="currency" value="" data-currency-field />
        <SpamGuard action="contact" />
        <FormEnd submit={c.submit} consent={c.consent} id="contact" />
      </form>

      <aside class="contact__panel" aria-label={draft.contactTitle}>
        <dl class="details">
          <div class="details__row">
            <dt><Icon name="mail" size={20} />{c.panel.email}</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          {
            site.whatsapp && (
              <div class="details__row">
                <dt>
                  <Icon name="message" size={20} />
                  {shell.footer.whatsapp}
                </dt>
                <dd>
                  <ExternalLink href={`https://wa.me/${site.whatsapp}`}>{c.panel.whatsapp}</ExternalLink>
                  <span class="details__note">{site.hours}</span>
                </dd>
              </div>
            )
          }
          {
            site.calUrl && (
              <div class="details__row">
                <dt>
                  <Icon name="phone" size={20} />
                  {c.panel.call}
                </dt>
                <dd>
                  <ExternalLink href={site.calUrl}>{c.panel.callLink}</ExternalLink>
                </dd>
              </div>
            )
          }
          <div class="details__row">
            <dt><Icon name="map-pin" size={20} />{c.panel.address}</dt>
            <dd><CopyText text={c.panel.postal} as="span" /></dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import "../scripts/forms";
</script>

<style>
  .contact {
    display: grid;
    gap: var(--section-y) var(--space-16);
  }

  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      align-items: start;
    }

    .contact__panel {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-8));
    }
  }

  .details {
    display: grid;
    margin: 0;
    border-block-start: 2px solid var(--color-text);
  }

  .details__row {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-5);
    border-block-end: 1px solid var(--color-border);
  }

  dt {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
    padding-inline-start: calc(20px + var(--space-2));
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
    overflow-wrap: anywhere;
  }

  dd a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
  }

  .details__note {
    display: block;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-text-muted);
  }
</style>
