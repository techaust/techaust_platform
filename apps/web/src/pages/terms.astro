---
// /terms (WEB-LEGAL): the website terms of use (07-A §2). VERIFY WITH CA/LEGAL. Layout: components/legal/LegalPage.astro.
import LegalPage from "../components/legal/LegalPage.astro";
import { legalPages } from "../content/legal-pages";
import BaseLayout from "../layouts/BaseLayout.astro";

const doc = legalPages.terms;
---

<BaseLayout title={doc.meta.title} description={doc.meta.description}>
  <LegalPage doc={doc} />
</BaseLayout>
