---
// /security (WEB-SEC, docs/07 §5.11 + 07-A §6): the responsible-disclosure policy, then the published security.txt
// exactly as /.well-known/security.txt serves it (built by the same function, so the two can't differ).
// 07-A v0.3: each point Researched or OPEN per 08-C (noted in content/legal-pages.ts). Layout: components/legal/LegalPage.astro.
import LegalPage from "../components/legal/LegalPage.astro";
import { site } from "../config/site";
import { legalPages } from "../content/legal-pages";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildSecurityTxt } from "../lib/machine-files";

const doc = legalPages.security;
// One span per line, each keeping its line break, so the text (and a copy of it) is the file's text.
const lines = buildSecurityTxt(site.securityTxtExpires).trimEnd().split("\n");
---

<BaseLayout title={doc.meta.title} description={doc.meta.description}>
  <LegalPage doc={doc}>
    <pre class="sectxt"><code>{lines.map((line, i) => <span class="sectxt__line">{i < lines.length - 1 ? `${line}\n` : line}</span>)}</code></pre>
  </LegalPage>
</BaseLayout>

<style>
  /* The file wraps instead of scrolling sideways (audit A2 finding 1): a scroll box the keyboard can't reach fails WCAG
     2.1.1 on phones. Lines break at spaces first and a long URL where it must; a wrapped line hangs under its field name,
     so each field still reads as one line. */
  .sectxt {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .sectxt__line {
    display: block;
    padding-inline-start: 2ch;
    text-indent: -2ch;
  }
</style>
