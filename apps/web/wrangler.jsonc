{
  // techaust.com public website (docs/05-architecture.md §4).
  // RULE: no D1/R2/KV bindings here, ever (CI guard: scripts/check-web-bindings.mjs).
  // Queue producer, rate limiter and Turnstile are added in M2.4. Custom domain only in Phase 7, with owner approval.
  // NOTE: the live site runs as the old Worker "techaust-web"; these names deliberately differ.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "techaust-platform-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Version/Preview URLs skip Cloudflare Access, so they stay off at every level (docs/runbooks/access-staging.md;
  // CI guard: scripts/check-worker-config.mjs).
  "preview_urls": false,
  // Workers Logs: query strings are removed from logged URLs (owner decision 2026-10-21, all four Workers).
  "observability": { "enabled": true, "redact_query_string": true },
  // Only the routes the Worker implements run it; any other /api path gets the static 404 without an invocation.
  // (The Worker keeps its own 404 for unknown /api routes. Add each new route here when it is built: M2.4.)
  "assets": { "directory": "./dist", "not_found_handling": "404-page", "run_worker_first": ["/api/geo", "/api/forms/*"] },
  "vars": { "ENVIRONMENT": "local" },
  "env": {
    "staging": {
      "name": "techaust-platform-web-staging",
      "workers_dev": true,
      // Version/Preview URLs would skip Cloudflare Access (docs/runbooks/access-staging.md).
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "staging" }
    },
    "production": {
      "name": "techaust-platform-web",
      "workers_dev": false,
      "preview_urls": false,
      // Production: NO invocation logs from day one (they carry the client IP, user agent and location of every
      // request, which the append-only access log already holds for security). Console logs stay on.
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false }
      },
      "vars": { "ENVIRONMENT": "production" }
    }
  }
}
