{
  // techaust.com public website (docs/05-architecture.md §4).
  // RULE: no D1/R2/KV bindings here, ever (CI guard: scripts/check-web-bindings.mjs). Since M2.4 the Worker has a Queues
  // producer (LEADS_QUEUE), a Rate Limiting binding (RL_FORMS) and Turnstile secrets, all allowed. Custom domain only in
  // Phase 7, with owner approval.
  // NOTE: the live site runs as the old Worker "techaust-web"; these names deliberately differ.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "techaust-platform-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Version/Preview URLs skip Cloudflare Access, so they stay off at every level (docs/runbooks/access-staging.md;
  // CI guard: scripts/check-worker-config.mjs).
  "preview_urls": false,
  // Workers Logs: query strings are removed from logged URLs (owner decision 2026-10-21, all four Workers).
  "observability": { "enabled": true, "redact_query_string": true },
  // Only the routes the Worker implements run it; any other /api path gets the static 404 without an invocation.
  // (The Worker keeps its own 404 for unknown /api routes. Add each new route here when it is built: M2.4.)
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/geo", "/api/forms/*"]
  },
  // Local values. TURNSTILE_SITE_KEY is Cloudflare's always-pass TEST key (public); the matching test secret is written
  // to .dev.vars by `pnpm dev:secrets`. FORMS_ALLOWED_ORIGINS: the page origins that may POST a form (FRM-03).
  "vars": {
    "ENVIRONMENT": "local",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_HOSTNAMES": "localhost",
    "FORMS_ALLOWED_ORIGINS": "http://localhost:4321,http://localhost:8787"
  },
  // Names only; values come from `wrangler secret put` (docs/runbooks/ses-and-turnstile.md). Not inherited by environments.
  "secrets": { "required": ["TURNSTILE_SECRET", "FORMS_IP_PEPPER"] },
  // Leads queue (producer): the jobs Worker consumes it. 2 submissions per 60 s per address is the first rate-limit layer
  // (the exact 5 per 10 min and 50 per day are enforced by the consumer, docs/13 2026-10-23).
  "queues": { "producers": [{ "binding": "LEADS_QUEUE", "queue": "techaust-local-leads" }] },
  "ratelimits": [{ "name": "RL_FORMS", "namespace_id": "4001", "simple": { "limit": 2, "period": 60 } }],
  "env": {
    "staging": {
      "name": "techaust-platform-web-staging",
      "workers_dev": true,
      // Version/Preview URLs would skip Cloudflare Access (docs/runbooks/access-staging.md).
      "preview_urls": false,
      // TURNSTILE_SITE_KEY: the public site key of the widget "techaust-staging-forms" (owner, 2026-10-23; runbook
      // docs/runbooks/ses-and-turnstile.md Part 5). Its secret is the Worker secret TURNSTILE_SECRET.
      "vars": {
        "ENVIRONMENT": "staging",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFhXQJodywYfgEIP",
        "TURNSTILE_HOSTNAMES": "techaust-platform-web-staging.techaust-technologies-153.workers.dev",
        "FORMS_ALLOWED_ORIGINS": "https://techaust-platform-web-staging.techaust-technologies-153.workers.dev"
      },
      "secrets": { "required": ["TURNSTILE_SECRET", "FORMS_IP_PEPPER"] },
      "queues": { "producers": [{ "binding": "LEADS_QUEUE", "queue": "techaust-staging-leads" }] },
      "ratelimits": [{ "name": "RL_FORMS", "namespace_id": "4001", "simple": { "limit": 2, "period": 60 } }]
    },
    "production": {
      "name": "techaust-platform-web",
      "workers_dev": false,
      "preview_urls": false,
      // Production: NO invocation logs from day one (they carry the client IP, user agent and location of every
      // request, which the append-only access log already holds for security). Console logs stay on.
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false }
      },
      // Production gets no queue, rate limiter or Turnstile secrets until Phase 7 (owner approval): the form endpoints
      // answer 503 here. TURNSTILE_SITE_KEY stays empty for the same reason.
      "vars": {
        "ENVIRONMENT": "production",
        "TURNSTILE_SITE_KEY": "",
        "TURNSTILE_HOSTNAMES": "techaust.com",
        "FORMS_ALLOWED_ORIGINS": "https://techaust.com"
      }
    }
  }
}
