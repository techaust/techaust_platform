{
  "configPath": "/home/runner/work/techaust_platform/techaust_platform/apps/portal/wrangler.jsonc",
  "userConfigPath": "/home/runner/work/techaust_platform/techaust_platform/apps/portal/wrangler.jsonc",
  "topLevelName": "techaust-platform-portal",
  "definedEnvironments": ["staging", "production"],
  "targetEnvironment": "staging",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "jsx_factory": "React.createElement",
  "jsx_fragment": "React.Fragment",
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "name": "techaust-platform-portal-staging",
  "main": "index.js",
  "triggers": {},
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "directory": "../client"
  },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "staging",
    "PAYMENTS_LIVE_ALLOWED": "false"
  },
  "secrets": {
    "required": ["PORTAL_KEY_PEPPER", "TURNSTILE_SECRET"]
  },
  "durable_objects": {
    "bindings": []
  },
  "workflows": [],
  "migrations": [],
  "exports": {},
  "kv_namespaces": [],
  "cloudchamber": {},
  "send_email": [],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "techaust-staging-email"
      },
      {
        "binding": "PDF_QUEUE",
        "queue": "techaust-staging-pdf"
      }
    ]
  },
  "connect": [],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "techaust-staging-docs"
    },
    {
      "binding": "FILES",
      "bucket_name": "techaust-staging-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techaust-staging",
      "database_id": "879c63dd-fedd-4710-9b13-21d8804879a9",
      "migrations_dir": "../../../../packages/db/migrations"
    }
  ],
  "vectorize": [],
  "ai_search_namespaces": [],
  "ai_search": [],
  "agent_memory": [],
  "hyperdrive": [],
  "services": [
    {
      "binding": "ADMIN_PAY",
      "service": "techaust-platform-admin-finance-staging",
      "entrypoint": "PortalPayments"
    }
  ],
  "analytics_engine_datasets": [],
  "dispatch_namespaces": [],
  "mtls_certificates": [],
  "pipelines": [],
  "k2": [],
  "secrets_store_secrets": [],
  "artifacts": [],
  "unsafe_hello_world": [],
  "flagship": [],
  "worker_loaders": [],
  "ratelimits": [
    {
      "name": "RL_SESSION",
      "namespace_id": "6201",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RL_SIGNIN",
      "namespace_id": "6202",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_LINKS",
      "namespace_id": "6203",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vpc_services": [],
  "vpc_networks": [],
  "logfwdr": {
    "bindings": []
  },
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "python_modules": {
    "exclude": ["**/*.pyc"]
  },
  "dev": {
    "ip": "127.0.0.1",
    "local_protocol": "http",
    "upstream_protocol": "http",
    "enable_containers": true,
    "generate_types": false
  },
  "no_bundle": true
}
