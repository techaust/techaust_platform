{
  // admin.techaust.com (docs/05-architecture.md §4). SPA assets + Hono API under /api/*.
  // The assets directory is filled in by @cloudflare/vite-plugin at build time.
  // D1 is bound from M1.3; R2 and queues follow with their milestones. Custom domains only in Phase 7, with owner approval.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "techaust-platform-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Version/Preview URLs skip Cloudflare Access, so they stay off at every level (docs/runbooks/access-staging.md;
  // CI guard: scripts/check-worker-config.mjs).
  "preview_urls": false,
  // Workers Logs (M1.5, owner's Q5): invocation logs stay ON here and in staging (the CPU benchmark reads `cpuTimeMs`
  // from them; only the owner's visits and the benchmark reach staging). The app's own `ev: "req"` lines and errors
  // are console logs and stay on everywhere. Query strings are removed from logged URLs.
  "observability": { "enabled": true, "redact_query_string": true },
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Turnstile on /login after 3 failures (M2.4b, ADM-AUTH-06). TURNSTILE_SITE_KEY: local = Cloudflare's always-pass TEST
  // key (public); the SPA reads it from here at build time, per CLOUDFLARE_ENV (a staging build with an empty key fails).
  // TURNSTILE_HOSTNAMES: the hosts the widget may run on (the Worker checks the hostname Cloudflare returns).
  "vars": {
    "ENVIRONMENT": "local",
    "PAYMENTS_LIVE_ALLOWED": "false",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_HOSTNAMES": "localhost",
    // Mirrors the jobs Worker's LEAD_PURGE_MODE so the deletion view can say the clean-up is a dry run (only "live" deletes).
    "LEAD_PURGE_MODE": "dry_run"
  },
  // Login secrets (docs/05 §4): names only; values are set with `wrangler secret put` (docs/runbooks/access-staging.md).
  // TURNSTILE_SECRET is the secret of the widget above (local: `pnpm dev:secrets` writes the always-pass test secret).
  // Not inherited by environments, so each env lists them too.
  "secrets": {
    "required": ["PASSWORD_PEPPER", "SALT_PEPPER", "TOTP_ENC_KEY", "SESSION_HMAC_KEY", "TURNSTILE_SECRET"]
  },
  // Email queue (producer, M2.4b): the staff security alerts go to the jobs Worker as an audit-row ID only (no address
  // leaves this Worker). The jobs Worker consumes it. Production has no queue until Phase 7 (owner approval).
  "queues": {
    "producers": [
      { "binding": "EMAIL_QUEUE", "queue": "techaust-local-email" },
      { "binding": "PDF_QUEUE", "queue": "techaust-local-pdf" }
    ]
  },
  // D1 (docs/05 §5). Migrations live in packages/db; local dev and tests use a local database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techaust-local",
      "database_id": "local",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // The admin API Worker (M5.0, docs/13 2026-10-27): every route except sign-in, the member's account and staff management is answered
  // there (apps/admin/wrangler.api.jsonc; no public URL). The admin finance Worker (M6.1 stage A): invoices, statements, reports, approvals
  // and the dashboard (apps/admin/wrangler.finance.jsonc; no public URL). Not inherited by environments, so each env lists both too.
  "services": [
    { "binding": "ADMIN_API", "service": "techaust-platform-admin-api" },
    { "binding": "ADMIN_FINANCE", "service": "techaust-platform-admin-finance" }
  ],
  // Private file vault (M3.4, ADM-PRJ-04): uploads and downloads go through this Worker only (no public bucket, no signed
  // URLs). Local dev and tests use Miniflare's R2. Production has no bucket until Phase 7 (owner approval).
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "techaust-local-files" },
    // The sent documents bucket (M4.4): staff download a PDF through this Worker (GET /api/v1/documents/:id/pdf), which only reads it, and the
    // owner's signature image is stored here under a hash-named key (settings/signature-*). The jobs Worker writes the envelopes and PDFs.
    { "binding": "DOCS", "bucket_name": "techaust-local-docs" }
  ],
  "env": {
    "staging": {
      "name": "techaust-platform-admin-staging",
      // Workers Traces on STAGING only (full audit A6 9, owner's yes 2026-10-30); production keeps its own block below, without traces.
      // Logs stay as before: on, invocation logs on, not sampled (the CPU benchmarks need every request, docs/13 2026-10-22).
      // Traces: 10 % of invocations (head sampling). Free plan, Cloudflare docs read 2026-10-30: traces are kept 7 days; from
      // 2026-12-01 logs and traces share the account's Observability allowance of 0.5 GB ingested a day, and ingestion stops for the
      // rest of the day when it is used up. Same rate on all five staging Workers (scripts/check-worker-config.mjs); headroom in
      // docs/runbooks/cpu-baseline.md ("Traces").
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": true },
        "traces": { "enabled": true, "head_sampling_rate": 0.1 }
      },
      "workers_dev": true,
      // Version/Preview URLs would skip Cloudflare Access (docs/runbooks/access-staging.md).
      "preview_urls": false,
      // TURNSTILE_SITE_KEY: the public key of the widget "techaust-staging-signin" (owner, 2026-10-23), shared with the
      // portal's staging host. Its secret is the Worker secret TURNSTILE_SECRET.
      "vars": {
        "ENVIRONMENT": "staging",
        "PAYMENTS_LIVE_ALLOWED": "false",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFhrfYyx9bhG6lmt",
        "TURNSTILE_HOSTNAMES": "techaust-platform-admin-staging.techaust-technologies-153.workers.dev",
        "LEAD_PURGE_MODE": "dry_run"
      },
      "secrets": {
        "required": ["PASSWORD_PEPPER", "SALT_PEPPER", "TOTP_ENC_KEY", "SESSION_HMAC_KEY", "TURNSTILE_SECRET"]
      },
      "services": [
        { "binding": "ADMIN_API", "service": "techaust-platform-admin-api-staging" },
        { "binding": "ADMIN_FINANCE", "service": "techaust-platform-admin-finance-staging" }
      ],
      "queues": {
        "producers": [
          { "binding": "EMAIL_QUEUE", "queue": "techaust-staging-email" },
          { "binding": "PDF_QUEUE", "queue": "techaust-staging-pdf" }
        ]
      },
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "techaust-staging-files" },
        { "binding": "DOCS", "bucket_name": "techaust-staging-docs" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "techaust-staging",
          "database_id": "879c63dd-fedd-4710-9b13-21d8804879a9",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    },
    "production": {
      "name": "techaust-platform-admin",
      "workers_dev": false,
      "preview_urls": false,
      // Production gets no queue and no widget until Phase 7 (owner approval): TURNSTILE_SITE_KEY stays empty.
      "vars": {
        "ENVIRONMENT": "production",
        "PAYMENTS_LIVE_ALLOWED": "false",
        "TURNSTILE_SITE_KEY": "",
        "TURNSTILE_HOSTNAMES": "admin.techaust.com"
      },
      "secrets": {
        "required": ["PASSWORD_PEPPER", "SALT_PEPPER", "TOTP_ENC_KEY", "SESSION_HMAC_KEY", "TURNSTILE_SECRET"]
      },
      "services": [
        { "binding": "ADMIN_API", "service": "techaust-platform-admin-api" },
        { "binding": "ADMIN_FINANCE", "service": "techaust-platform-admin-finance" }
      ],
      // No R2 bucket (FILES) in production until Phase 7.
      // Production: NO invocation logs from day one (they carry the client IP, user agent and location of every staff
      // request, which the append-only access log already holds for security). Console logs stay on.
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false }
      }
    }
  }
}
