{
  // admin.techaust.com (docs/05-architecture.md §4). SPA assets + Hono API under /api/*.
  // The assets directory is filled in by @cloudflare/vite-plugin at build time.
  // D1 is bound from M1.3; R2 and queues follow with their milestones. No routes or custom domain in any scope: the lead attaches
  // admin.techaust.com by hand (P7).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "techaust-platform-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Version/Preview URLs skip Cloudflare Access, so they stay off at every level (docs/runbooks/access-staging.md;
  // CI guard: scripts/check-worker-config.mjs).
  "preview_urls": false,
  // Workers Logs (M1.5, owner's Q5): invocation logs stay ON here and in staging (the CPU benchmark reads `cpuTimeMs`
  // from them; only the owner's visits and the benchmark reach staging). The app's own `ev: "req"` lines and errors
  // are console logs and stay on everywhere. Query strings are removed from logged URLs.
  "observability": { "enabled": true, "redact_query_string": true },
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Turnstile on /login after 3 failures (M2.4b, ADM-AUTH-06). TURNSTILE_SITE_KEY: local = Cloudflare's always-pass TEST
  // key (public); the SPA reads it from here at build time, per CLOUDFLARE_ENV (a staging build with an empty key fails).
  // TURNSTILE_HOSTNAMES: the hosts the widget may run on (the Worker checks the hostname Cloudflare returns).
  "vars": {
    "ENVIRONMENT": "local",
    "PAYMENTS_LIVE_ALLOWED": "false",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_HOSTNAMES": "localhost",
    // The portal of this environment, for the staff reply to an acceptance by email (07-ZE line 5, T6); read at build time by vite.config.ts
    // (scripts/website-origin.mjs `portalOriginForApp`) into the SPA as __PORTAL_ORIGIN__. An origin: no path, no trailing slash.
    "PORTAL_ORIGIN": "http://localhost:5174"
  },
  // Login secrets (docs/05 §4): names only; values are set with `wrangler secret put` (docs/runbooks/access-staging.md).
  // TURNSTILE_SECRET is the secret of the widget above (local: `pnpm dev:secrets` writes the always-pass test secret).
  // Not inherited by environments, so each env lists them too.
  "secrets": {
    "required": ["PASSWORD_PEPPER", "SALT_PEPPER", "TOTP_ENC_KEY", "SESSION_HMAC_KEY", "TURNSTILE_SECRET"]
  },
  // M7.5 (C2, L2, L5, L22): in-Worker Rate Limiting (free; per Cloudflare location, not exact), on the FRONT only (the API, finance and invoices Workers are
  // reached only through it), checked before any D1 work and before Turnstile's siteverify: RL_SESSION per signed-in session (240 a minute: a screen loads
  // several lists), keyed on an HMAC under SESSION_HMAC_KEY, on every forwarded request and every front route that needs a session; RL_SIGNIN per address on
  // /auth/salt, /login, /totp and /recovery, RL_INVITE per address on /auth/invite/start, /finish and /totp (each route its own counter), keyed on the
  // address's HMAC under SALT_PEPPER. Not inherited by environments, so each env lists them, each purpose and scope with its own namespace_id (unique in the
  // account; scripts/check-worker-config.mjs).
  "ratelimits": [
    { "name": "RL_SESSION", "namespace_id": "5101", "simple": { "limit": 240, "period": 60 } },
    { "name": "RL_SIGNIN", "namespace_id": "5102", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_INVITE", "namespace_id": "5103", "simple": { "limit": 10, "period": 60 } }
  ],
  // Email queue (producer, M2.4b): the staff security alerts go to the jobs Worker as an audit-row ID only (no address
  // leaves this Worker). The jobs Worker consumes it.
  "queues": {
    "producers": [
      { "binding": "EMAIL_QUEUE", "queue": "techaust-local-email" },
      { "binding": "PDF_QUEUE", "queue": "techaust-local-pdf" }
    ]
  },
  // D1 (docs/05 §5). Migrations live in packages/db; local dev and tests use a local database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techaust-local",
      "database_id": "local",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // The admin API Worker (M5.0, docs/13 2026-10-27): every route except sign-in, the member's account and staff management is answered
  // there (apps/admin/wrangler.api.jsonc; no public URL). The admin finance Worker (M6.1 stage A; the payments side since the fourth Worker): payments,
  // the ledger, credit, advices and the gateways (apps/admin/wrangler.finance.jsonc; no public URL). The admin invoices Worker (the fourth admin Worker,
  // 2026-11-03): invoices and notes, statements, reports, approvals and the dashboard (apps/admin/wrangler.invoices.jsonc; no public URL). Not inherited
  // by environments, so each env lists all three too.
  "services": [
    { "binding": "ADMIN_API", "service": "techaust-platform-admin-api" },
    { "binding": "ADMIN_FINANCE", "service": "techaust-platform-admin-finance" },
    { "binding": "ADMIN_INVOICES", "service": "techaust-platform-admin-invoices" }
  ],
  // Private file vault (M3.4, ADM-PRJ-04): uploads and downloads go through this Worker only (no public bucket, no signed
  // URLs). Local dev and tests use Miniflare's R2.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "techaust-local-files" },
    // The sent documents bucket (M4.4): staff download a PDF through this Worker (GET /api/v1/documents/:id/pdf), which only reads it, and the
    // owner's signature image is stored here under a hash-named key (settings/signature-*). The jobs Worker writes the envelopes and PDFs.
    { "binding": "DOCS", "bucket_name": "techaust-local-docs" }
  ],
  "env": {
    "staging": {
      "name": "techaust-platform-admin-staging",
      // Workers Traces on STAGING only (full audit A6 9, owner's yes 2026-10-30); production keeps its own block below, without traces.
      // Logs stay as before: on, invocation logs on, not sampled (the CPU benchmarks need every request, docs/13 2026-10-22).
      // Traces: 10 % of invocations (head sampling). Free plan, Cloudflare docs read 2026-10-30: traces are kept 7 days; from
      // 2026-12-01 logs and traces share the account's Observability allowance of 0.5 GB ingested a day, and ingestion stops for the
      // rest of the day when it is used up. Same rate on all five staging Workers (scripts/check-worker-config.mjs); headroom in
      // docs/runbooks/cpu-baseline.md ("Traces").
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": true },
        "traces": { "enabled": true, "head_sampling_rate": 0.1 }
      },
      "workers_dev": true,
      // Version/Preview URLs would skip Cloudflare Access (docs/runbooks/access-staging.md).
      "preview_urls": false,
      // TURNSTILE_SITE_KEY: the public key of the widget "techaust-staging-signin" (owner, 2026-10-23), shared with the
      // portal's staging host. Its secret is the Worker secret TURNSTILE_SECRET.
      "vars": {
        "ENVIRONMENT": "staging",
        "PAYMENTS_LIVE_ALLOWED": "false",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFhrfYyx9bhG6lmt",
        "TURNSTILE_HOSTNAMES": "techaust-platform-admin-staging.techaust-technologies-153.workers.dev",
        "PORTAL_ORIGIN": "https://techaust-platform-portal-staging.techaust-technologies-153.workers.dev"
      },
      "secrets": {
        "required": ["PASSWORD_PEPPER", "SALT_PEPPER", "TOTP_ENC_KEY", "SESSION_HMAC_KEY", "TURNSTILE_SECRET"]
      },
      "ratelimits": [
        { "name": "RL_SESSION", "namespace_id": "5201", "simple": { "limit": 240, "period": 60 } },
        { "name": "RL_SIGNIN", "namespace_id": "5202", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_INVITE", "namespace_id": "5203", "simple": { "limit": 10, "period": 60 } }
      ],
      "services": [
        { "binding": "ADMIN_API", "service": "techaust-platform-admin-api-staging" },
        { "binding": "ADMIN_FINANCE", "service": "techaust-platform-admin-finance-staging" },
        { "binding": "ADMIN_INVOICES", "service": "techaust-platform-admin-invoices-staging" }
      ],
      "queues": {
        "producers": [
          { "binding": "EMAIL_QUEUE", "queue": "techaust-staging-email" },
          { "binding": "PDF_QUEUE", "queue": "techaust-staging-pdf" }
        ]
      },
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "techaust-staging-files" },
        { "binding": "DOCS", "bucket_name": "techaust-staging-docs" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "techaust-staging",
          "database_id": "879c63dd-fedd-4710-9b13-21d8804879a9",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    },
    "production": {
      "name": "techaust-platform-admin",
      // No workers.dev and no routes or custom domain (P7, launch 2026-11-08): the lead attaches admin.techaust.com by hand, behind Cloudflare Access
      // (a bypass for /api/health only). P7-A (docs/runs/p7-launch.md): every binding of env.staging, naming the production resources
      // (scripts/check-worker-config.mjs). TURNSTILE_SITE_KEY: the public key of the widget "techaust-prod-signin" (hostnames admin.techaust.com
      // and portal.techaust.com; lead, 2026-11-07), shared with the portal's production host. Its secret is the Worker secret TURNSTILE_SECRET.
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "PAYMENTS_LIVE_ALLOWED": "false",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAF3fIdhlCqOre8yu",
        "TURNSTILE_HOSTNAMES": "admin.techaust.com",
        "PORTAL_ORIGIN": "https://portal.techaust.com"
      },
      "secrets": {
        "required": ["PASSWORD_PEPPER", "SALT_PEPPER", "TOTP_ENC_KEY", "SESSION_HMAC_KEY", "TURNSTILE_SECRET"]
      },
      "ratelimits": [
        { "name": "RL_SESSION", "namespace_id": "5301", "simple": { "limit": 240, "period": 60 } },
        { "name": "RL_SIGNIN", "namespace_id": "5302", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_INVITE", "namespace_id": "5303", "simple": { "limit": 10, "period": 60 } }
      ],
      "services": [
        { "binding": "ADMIN_API", "service": "techaust-platform-admin-api" },
        { "binding": "ADMIN_FINANCE", "service": "techaust-platform-admin-finance" },
        { "binding": "ADMIN_INVOICES", "service": "techaust-platform-admin-invoices" }
      ],
      "queues": {
        "producers": [
          { "binding": "EMAIL_QUEUE", "queue": "techaust-prod-email" },
          { "binding": "PDF_QUEUE", "queue": "techaust-prod-pdf" }
        ]
      },
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "techaust-prod-files" },
        { "binding": "DOCS", "bucket_name": "techaust-prod-docs" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "techaust-prod",
          "database_id": "d16029d2-373e-4b66-beb0-d77158d6dfc2",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      // Production: NO invocation logs from day one (they carry the client IP, user agent and location of every staff
      // request, which the append-only access log already holds for security). Console logs stay on.
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false }
      }
    }
  }
}
