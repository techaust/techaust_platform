{
  "name": "@techaust/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs admin",
    "build": "vite build && node ../../scripts/check-spa-headers.mjs admin && node ../../scripts/worker-budget.mjs admin && node ../../scripts/worker-budget.mjs adminApi",
    "typecheck": "wrangler types --env staging && tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && node ../../scripts/check-spa-headers.mjs admin && wrangler deploy --config dist/techaust_platform_admin_api/wrangler.json && wrangler deploy",
    "types": "wrangler types --env staging",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hono/standard-validator": "0.4.0",
    "@techaust/auth": "workspace:*",
    "@techaust/core": "workspace:*",
    "@techaust/db": "workspace:*",
    "@techaust/ui": "workspace:*",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/vitest-plugin": "1.3.6",
    "@playwright/test": "1.64.1",
    "@techaust/config": "workspace:*",
    "@techaust/pdf": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
