// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sendStatements SQL is unchanged by the shared helpers [LD3] > approval needed 1`] = `
[
  {
    "sql": "UPDATE documents SET series = ?2, fy = ?3, number = (SELECT next_no - 1 FROM doc_counters WHERE series = ?2 AND fy = ?3), number_display = printf(?5, ?3, (SELECT next_no - 1 FROM doc_counters WHERE series = ?2 AND fy = ?3)),
         status = 'sent', frozen_at = ?6, sent_at = ?6, issue_date = ?7, valid_until = ?8, recipient = ?9, issuer = ?10, computed = ?11,
         snapshot_sha256 = ?12, issued_by = ?13, updated_at = ?6
       WHERE id = ?1 AND status = 'draft' AND frozen_at IS NULL AND updated_at = ?14 AND content_sha256 = ?15
         AND (SELECT version FROM settings WHERE key = 'numbering') IS ?16
         AND NOT EXISTS (SELECT 1 FROM documents x WHERE x.version_group_id = ?4 AND x.status IN ('accepted', 'converted'))
         AND NOT EXISTS (SELECT 1 FROM clients z WHERE z.id = documents.client_id AND z.anonymised_at IS NOT NULL)
         AND (SELECT next_no - 1 FROM doc_counters WHERE series = ?2 AND fy = ?3) <= 9999 AND EXISTS (SELECT 1 FROM approvals ap WHERE ap.document_id = documents.id AND ap.kind = 'discount' AND ap.status = 'approved' AND ap.content_sha256 = documents.content_sha256)
       RETURNING number_display, valid_until",
    "values": [
      "doc1",
      "proposal",
      "2627",
      "grp1",
      "TH/PRP/%s/%04d",
      1700000000000,
      "2026-10-28",
      "2026-11-12",
      "{"legalName":"Client","country":"IN"}",
      "{"company":{"tradeName":"T","legalName":"L","address":"A","gstin":null,"stateCode":"19","logo":"logo-primary-color.svg"},"sender":{"staffId":"s1","name":"N","email":"n@example.com"}}",
      "{"x":1}",
      "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "user1",
      5,
      "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      3,
    ],
  },
  {
    "sql": "INSERT INTO issue_guard (document_id) VALUES (?1)",
    "values": [
      "doc1",
    ],
  },
  {
    "sql": "INSERT INTO doc_counters (series, fy, next_no) VALUES (?1, ?2, 1) ON CONFLICT DO NOTHING",
    "values": [
      "proposal",
      "2627",
    ],
  },
  {
    "sql": "UPDATE doc_counters SET next_no = next_no + 1 WHERE series = ?1 AND fy = ?2",
    "values": [
      "proposal",
      "2627",
    ],
  },
  {
    "sql": "INSERT INTO issue_result (document_id, series, fy) SELECT ?1, ?2, ?3",
    "values": [
      "doc1",
      "proposal",
      "2627",
    ],
  },
  {
    "sql": "UPDATE documents SET status = 'revised' WHERE version_group_id = ?1 AND version < ?2 AND status IN ('sent', 'viewed')
             AND EXISTS (SELECT 1 FROM documents n WHERE n.id = ?3 AND n.status = 'sent' AND n.frozen_at IS NOT NULL)",
    "values": [
      "grp1",
      1,
      "doc1",
    ],
  },
]
`;

