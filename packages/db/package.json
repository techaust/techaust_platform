{
  "name": "@techaust/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, SQL migrations (incl. triggers), repositories and seed data for D1.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "seed:sql": "node scripts/seed-sql.ts",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@techaust/config": "workspace:*",
    "@types/node": "24.19.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "dependencies": {
    "@techaust/core": "workspace:*",
    "drizzle-orm": "0.45.3"
  }
}
