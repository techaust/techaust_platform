{
  "name": "@techaust/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, SQL migrations (incl. triggers), repositories and seed data for D1.",
  "exports": {
    ".": "./src/index.ts",
    "./billing": "./src/billing.ts",
    "./backup-scope": "./src/backup-scope.ts",
    "./care": "./src/care.ts",
    "./consent": "./src/consent.ts",
    "./contact-access": "./src/contact-access.ts",
    "./advices": "./src/advices.ts",
    "./deeds": "./src/deeds.ts",
    "./digest": "./src/digest.ts",
    "./dp-shared": "./src/dp-shared.ts",
    "./documents": "./src/documents.ts",
    "./email-events": "./src/email-events.ts",
    "./gateway": "./src/gateway.ts",
    "./issue": "./src/issue.ts",
    "./lead-stage": "./src/lead-stage.ts",
    "./ledger": "./src/ledger.ts",
    "./log": "./src/log.ts",
    "./offer-redaction": "./src/offer-redaction.ts",
    "./pdf-repairs": "./src/pdf-repairs.ts",
    "./portal-shared": "./src/portal-shared.ts",
    "./r2-sweep": "./src/r2-sweep.ts",
    "./realisation": "./src/realisation.ts",
    "./receipts": "./src/receipts.ts",
    "./refunds": "./src/refunds.ts",
    "./reports": "./src/reports.ts",
    "./reports-delivery": "./src/reports-delivery.ts",
    "./retention": "./src/retention.ts",
    "./signin-pending": "./src/signin-pending.ts",
    "./sql-rules": "./src/sql-rules.ts",
    "./warm": "./src/warm.ts",
    "./catalogue": "./src/seed/catalogue.ts",
    "./seed-templates": "./src/seed/templates.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "seed:sql": "node scripts/seed-sql.ts",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@techaust/config": "workspace:*",
    "@types/node": "24.19.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.156.2"
  },
  "dependencies": {
    "@techaust/core": "workspace:*",
    "drizzle-orm": "0.45.3"
  }
}
