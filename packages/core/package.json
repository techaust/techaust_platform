{
  "name": "@techaust/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Pure domain logic: money, tax engine, numbering, FY dates, schedules, permissions, shared schemas (no I/O).",
  "exports": {
    ".": "./src/index.ts",
    "./audit": "./src/audit.ts",
    "./catalogue": "./src/catalogue.ts",
    "./bank": "./src/bank.ts",
    "./clients": "./src/clients.ts",
    "./dates": "./src/dates.ts",
    "./documents": "./src/documents.ts",
    "./hash": "./src/hash.ts",
    "./email-templates": "./src/email-templates.ts",
    "./gstin": "./src/gstin.ts",
    "./form-labels": "./src/form-labels.ts",
    "./ids": "./src/ids.ts",
    "./lead-ref": "./src/lead-ref.ts",
    "./schedule-text": "./src/schedule-text.ts",
    "./lead-lifecycle": "./src/lead-lifecycle.ts",
    "./file-types": "./src/file-types.ts",
    "./markdown": "./src/markdown.ts",
    "./projects": "./src/projects.ts",
    "./numbering": "./src/numbering.ts",
    "./permissions": "./src/permissions.ts",
    "./reply-templates": "./src/reply-templates.ts",
    "./settings": "./src/schemas/settings.ts",
    "./site-references": "./src/site-references.ts",
    "./tax": "./src/tax/index.ts",
    "./terms": "./src/terms.ts",
    "./text": "./src/text.ts",
    "./user-agent": "./src/user-agent.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@techaust/config": "workspace:*",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
