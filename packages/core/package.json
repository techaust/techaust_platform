{
  "name": "@techaust/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Pure domain logic: money, tax engine, numbering, FY dates, schedules, permissions, shared schemas (no I/O).",
  "exports": {
    ".": "./src/index.ts",
    "./audit": "./src/audit.ts",
    "./dates": "./src/dates.ts",
    "./email-templates": "./src/email-templates.ts",
    "./ids": "./src/ids.ts",
    "./numbering": "./src/numbering.ts",
    "./permissions": "./src/permissions.ts",
    "./settings": "./src/schemas/settings.ts",
    "./terms": "./src/terms.ts",
    "./user-agent": "./src/user-agent.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@techaust/config": "workspace:*",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
