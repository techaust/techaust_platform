{
  "name": "@techaust/pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Document templates (HTML + print CSS), embedded fonts and the Browser Run render client.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:assets": "node scripts/build-assets.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage --passWithNoTests",
    "test:visual": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@techaust/core": "workspace:*"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@playwright/test": "1.64.1",
    "@techaust/config": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
