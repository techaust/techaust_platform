# Names of every variable/secret used by the platform. NEVER put real values in this file.
# Local Workers dev: copy apps/<app>/.dev.vars.example to apps/<app>/.dev.vars (git-ignored).
# Staging/production: `wrangler secret put <NAME> --env <staging|production>` (run by the owner).
# CI: GitHub repo secrets.

# --- plain vars (wrangler.jsonc "vars") ---
# ENVIRONMENT=local|staging|production
# APP_ORIGIN=
# PAYMENTS_LIVE_ALLOWED=false

# --- web ---
# TURNSTILE_SECRET=

# --- admin ---
# PASSWORD_PEPPER=
# SALT_PEPPER=
# TOTP_ENC_KEY=
# SESSION_HMAC_KEY=
# BUILD_SNAPSHOT_TOKEN=

# --- portal ---
# MAGIC_LINK_KEY=
# DOC_TOKEN_KEY=

# --- jobs ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_EVENTS_TOKEN=
# SENTRY_DSN=

# --- GitHub Actions repo secrets ---
# CLOUDFLARE_ACCOUNT_ID=
# CF_API_TOKEN_STAGING=
# CF_API_TOKEN_PROD=
# CF_API_TOKEN_BACKUP=
